NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_RD_STATION_TOKEN=
NEXT_PUBLIC_GA_ID=

# Sanity — site. Sem PROJECT_ID o site usa o conteúdo local de src/data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Segredo do webhook de revalidação (o mesmo cadastrado no webhook do Sanity).
SANITY_REVALIDATE_SECRET=

# Sanity — Studio (npx sanity dev/deploy só lê variáveis SANITY_STUDIO_*).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

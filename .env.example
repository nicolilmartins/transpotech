NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_RD_STATION_TOKEN=
NEXT_PUBLIC_GA_ID=

# RD Station Marketing — API Key de conversões, gerada em
# https://appstore.rdstation.com/pt-BR/publisher → "Gerar chave de API"
# (usuário Gestor ou Dono). Não é o token público nem o privado de
# Integrações. Só no servidor: nunca com NEXT_PUBLIC. Sem ela, em dev a rota
# /api/leads só devolve o payload montado; em produção responde erro.
RD_STATION_API_KEY=

# Sanity — opcionais: o projeto e o dataset já estão em src/sanity/env.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Opcional: segredo do webhook de revalidação imediata (o mesmo cadastrado no
# webhook do Sanity). Sem ele, o site atualiza o conteúdo a cada 60 s.
SANITY_REVALIDATE_SECRET=

# Sanity — Studio, opcionais (npx sanity dev/deploy só lê SANITY_STUDIO_*).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
